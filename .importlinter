# The provider core and the agent client are independent of their former host
# and of the sibling auth library: everything host-specific reaches them through
# the ports a host supplies. The agent service builds on both and nothing builds
# on it; the core builds on the client and never the other way round, so the
# client stays installable without the provider machinery. Only the service
# verifies user and workload tokens, so only the service may import webauth; an
# app verifies run capabilities through agent_runtime_client.mcp_server.
# Only the service builds on a web framework, so neither the core nor the
# client imports one; the client's MCP server is plain ASGI. The mcp-server
# extra stays an extra, so neither the core nor a client base module (the
# package __init__ included) imports agent_runtime_client.mcp_server, PyJWT or
# cryptography. Inside the core, only the routers (catalog, dispatch) import a
# provider package; the machinery below them never does.
# CI runs `lint-imports` over the real import graph, so an indirect chain is
# caught as well as a direct import.
[importlinter]
include_external_packages = True
root_packages =
    agent_runtime_service
    agent_runtime
    agent_runtime_client

[importlinter:contract:agent-runtime-reaches-back-into-no-host]
name = agent_runtime and agent_runtime_client reach back into no host
type = forbidden
source_modules =
    agent_runtime
    agent_runtime_client
forbidden_modules =
    songmaker_cli
    webauth

[importlinter:contract:agent-runtime-service-reaches-back-into-no-host]
name = agent_runtime_service reaches back into no host
type = forbidden
source_modules =
    agent_runtime_service
forbidden_modules =
    songmaker_cli

[importlinter:contract:agent-runtime-service-builds-on-core-builds-on-client]
name = agent_runtime_service builds on agent_runtime, which builds on agent_runtime_client, never the reverse
type = layers
layers =
    agent_runtime_service
    agent_runtime
    agent_runtime_client

[importlinter:contract:neutral-run-modules-name-no-provider]
name = inside the core, only the routers import a provider package; the machinery below them never does
type = forbidden
source_modules =
    agent_runtime.cli_run
    agent_runtime.anchored_turn
    agent_runtime.lost_groups
    agent_runtime.transcript
    agent_runtime.process
    agent_runtime.spawn
    agent_runtime.procfs
    agent_runtime.config
    agent_runtime.constants
    agent_runtime.errors
    agent_runtime.events
    agent_runtime.tools
    agent_runtime.tool_loop
    agent_runtime.text_tool_protocol
    agent_runtime.outlasting
    agent_runtime.secret_file
    agent_runtime.codex_login
    agent_runtime.grok_login
    agent_runtime.openai_adapter
    agent_runtime.images
    agent_runtime.sandbox
forbidden_modules =
    agent_runtime.claude
    agent_runtime.codex
    agent_runtime.grok

[importlinter:contract:only-the-service-imports-a-web-framework]
name = only the service imports a web framework
type = forbidden
source_modules =
    agent_runtime
    agent_runtime_client
forbidden_modules =
    fastapi
    starlette
    uvicorn

[importlinter:contract:mcp-server-stays-an-extra]
name = the core imports neither agent_runtime_client.mcp_server nor its extras
type = forbidden
source_modules =
    agent_runtime
forbidden_modules =
    agent_runtime_client.mcp_server
    jwt
    cryptography

# as_packages = False keeps agent_runtime_client itself (its __init__) a source without
# making the mcp_server package inside it one; the ** wildcard keeps every
# mcp_server module forbidden.
[importlinter:contract:client-base-stays-free-of-mcp-server]
name = the client base modules import neither agent_runtime_client.mcp_server nor its extras
type = forbidden
as_packages = False
source_modules =
    agent_runtime_client
    agent_runtime_client.agents
    agent_runtime_client.capability
    agent_runtime_client.errors
    agent_runtime_client.mcp_wire
    agent_runtime_client.run_stream
    agent_runtime_client.sse
    agent_runtime_client.tools
    agent_runtime_client.wire
forbidden_modules =
    agent_runtime_client.mcp_server
    agent_runtime_client.mcp_server.**
    jwt
    cryptography
