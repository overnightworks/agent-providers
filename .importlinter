# The provider core and the agent client are independent of their former host
# and of the sibling auth library: everything host-specific reaches them through
# the ports a host supplies. The agent service builds on both and nothing builds
# on it; the core builds on the client and never the other way round, so the
# client stays installable without the provider machinery. Only the service
# verifies user and workload tokens, so only the service may import webauth; an
# app verifies run capabilities through agent_client.mcp_server.
# Only the service builds on a web framework, so neither the core nor the
# client imports one; the client's MCP server is plain ASGI. The mcp-server
# extra stays an extra, so neither the core nor a client base module (the
# package __init__ included) imports agent_client.mcp_server, PyJWT or
# cryptography. Only the routers (catalog, dispatch) import a provider package;
# the machinery the provider packages build on never reaches back into one.
# CI runs `lint-imports` over the real import graph, so an indirect chain is
# caught as well as a direct import.
[importlinter]
include_external_packages = True
root_packages =
    agent_service
    agent_providers
    agent_client

[importlinter:contract:agent-providers-reaches-back-into-no-host]
name = agent_providers and agent_client reach back into no host
type = forbidden
source_modules =
    agent_providers
    agent_client
forbidden_modules =
    songmaker_cli
    webauth

[importlinter:contract:agent-service-reaches-back-into-no-host]
name = agent_service reaches back into no host
type = forbidden
source_modules =
    agent_service
forbidden_modules =
    songmaker_cli

[importlinter:contract:agent-service-builds-on-core-builds-on-client]
name = agent_service builds on agent_providers, which builds on agent_client, never the reverse
type = layers
layers =
    agent_service
    agent_providers
    agent_client

[importlinter:contract:neutral-run-modules-name-no-provider]
name = only the routers import a provider package; the machinery below them never does
type = forbidden
source_modules =
    agent_providers.cli_run
    agent_providers.anchored_turn
    agent_providers.lost_groups
    agent_providers.transcript
    agent_providers.process
    agent_providers.spawn
    agent_providers.procfs
    agent_providers.config
    agent_providers.constants
    agent_providers.errors
    agent_providers.events
    agent_providers.tools
    agent_providers.tool_loop
    agent_providers.text_tool_protocol
    agent_providers.outlasting
    agent_providers.secret_file
    agent_providers.codex_login
    agent_providers.openai_adapter
    agent_providers.images
    agent_providers.sandbox
forbidden_modules =
    agent_providers.claude
    agent_providers.codex
    agent_providers.grok

[importlinter:contract:only-the-service-imports-a-web-framework]
name = only the service imports a web framework
type = forbidden
source_modules =
    agent_providers
    agent_client
forbidden_modules =
    fastapi
    starlette
    uvicorn

[importlinter:contract:mcp-server-stays-an-extra]
name = the core imports neither agent_client.mcp_server nor its extras
type = forbidden
source_modules =
    agent_providers
forbidden_modules =
    agent_client.mcp_server
    jwt
    cryptography

# as_packages = False keeps agent_client itself (its __init__) a source without
# making the mcp_server package inside it one.
[importlinter:contract:client-base-stays-free-of-mcp-server]
name = the client base modules import neither agent_client.mcp_server nor its extras
type = forbidden
as_packages = False
source_modules =
    agent_client
    agent_client.agents
    agent_client.capability
    agent_client.errors
    agent_client.mcp_wire
    agent_client.run_stream
    agent_client.sse
    agent_client.tools
    agent_client.wire
forbidden_modules =
    agent_client.mcp_server
    jwt
    cryptography
